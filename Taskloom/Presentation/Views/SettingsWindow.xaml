<Window x:Class="Taskloom.Presentation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:markup="clr-namespace:Taskloom.Common.Markup"
        mc:Ignorable="d"
        Title="{markup:Loc Settings.WindowTitle}"
        Width="440"
        Height="460"
        MinWidth="420"
        MinHeight="420"
        Background="{DynamicResource App.BorderStrongBrush}"
        Icon="/Assets/Icons/Taskloom.ico"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="48"
            CornerRadius="0"
            GlassFrameThickness="0"
            NonClientFrameEdges="None"
            ResizeBorderThickness="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border
        Padding="1"
        Background="{DynamicResource App.BorderStrongBrush}">
        <Grid Background="{DynamicResource App.SurfacePrimaryBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Background="{DynamicResource App.SurfaceSecondaryBrush}"
                MouseLeftButtonDown="CustomTitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Margin="24,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource App.TextPrimaryBrush}"
                    Text="{markup:Loc Settings.WindowTitle}" />

                <Button
                    Grid.Column="1"
                    Margin="0,7,12,0"
                    Style="{StaticResource WindowCloseCaptionButtonStyle}"
                    Click="CloseButton_OnClick"
                    Content="&#xE8BB;"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource App.TextPrimaryBrush}"
                    Text="{markup:Loc Settings.Header}" />

                <TextBlock
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                    Text="{markup:Loc Settings.Description}" />

                <StackPanel Grid.Row="2" Margin="0,24,0,0">
                    <TextBlock FontSize="12" Foreground="{DynamicResource App.TextMutedBrush}" Text="{markup:Loc Settings.Language}" />
                    <ComboBox
                        Margin="0,8,0,0"
                        ItemsSource="{Binding Languages}"
                        DisplayMemberPath="Title"
                        SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,18,0,0">
                    <TextBlock FontSize="12" Foreground="{DynamicResource App.TextMutedBrush}" Text="{markup:Loc Settings.Theme}" />
                    <ComboBox
                        Margin="0,8,0,0"
                        ItemsSource="{Binding Themes}"
                        DisplayMemberPath="Title"
                        SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,18,0,0">
                    <TextBlock FontSize="12" Foreground="{DynamicResource App.TextMutedBrush}" Text="{markup:Loc Settings.Cleanup}" />
                    <ComboBox
                        x:Name="CleanupModeComboBox"
                        Margin="0,8,0,0"
                        ItemsSource="{Binding CleanupModes}"
                        DisplayMemberPath="Title"
                        SelectedItem="{Binding SelectedCleanupMode, Mode=TwoWay}"
                        SelectionChanged="CleanupModeComboBox_OnSelectionChanged" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource App.TextSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="{markup:Loc Settings.CleanupDescription}" />
                </StackPanel>

                <TextBlock
                    Grid.Row="5"
                    Margin="0,16,0,0"
                    Foreground="{DynamicResource App.ErrorBrush}"
                    TextWrapping="Wrap"
                    Text="{Binding StatusText}" />
            </Grid>
        </Grid>
    </Border>
</Window>
