<Window x:Class="Taskloom.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Taskloom.Common.Converters"
        xmlns:text="clr-namespace:Taskloom.Common.Text"
        xmlns:domain="clr-namespace:Taskloom.Domain"
        xmlns:markup="clr-namespace:Taskloom.Common.Markup"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1460"
        Height="920"
        MinWidth="1280"
        MinHeight="800"
        Background="{DynamicResource App.WindowBackgroundBrush}"
        Icon="/Assets/Icons/Taskloom.ico"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        PreviewMouseLeftButtonDown="MainWindow_OnPreviewMouseLeftButtonDown"
        ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="48"
            CornerRadius="0"
            GlassFrameThickness="0"
            NonClientFrameEdges="None"
            ResizeBorderThickness="8"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:AdaptiveCardWidthConverter x:Key="AdaptiveCardWidthConverter" />
        <converters:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter" />
        <converters:AudioCoverSourceToBitmapConverter x:Key="AudioCoverSourceToBitmapConverter" />
        <Style x:Key="CreatedAtChipBorderStyle" TargetType="Border" BasedOn="{StaticResource NeutralChipBorderStyle}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Opacity" Value="0.92" />
        </Style>
        <Style x:Key="CreatedAtChipTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ChipTextStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextMutedBrush}" />
        </Style>
        <Style x:Key="CalendarPanelButtonStyle" TargetType="{x:Type CalendarButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CalendarButton}">
                        <Border
                            x:Name="RootBorder"
                            Margin="2"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="8,6">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource App.TextPrimaryBrush}"
                                Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource App.SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarPanelDayButtonStyle" TargetType="{x:Type CalendarDayButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                        <Border
                            x:Name="RootBorder"
                            Margin="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="7,5">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource App.TextPrimaryBrush}"
                                Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource App.SurfaceHoverBrush}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource App.BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource App.SurfaceSelectedBrush}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource App.BorderSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource App.AccentPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.62" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarPanelStyle" TargetType="{x:Type Calendar}">
            <Setter Property="Background" Value="{DynamicResource App.SurfaceSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
            <Setter Property="CalendarButtonStyle" Value="{StaticResource CalendarPanelButtonStyle}" />
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarPanelDayButtonStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Calendar}">
                        <CalendarItem
                            x:Name="PART_CalendarItem"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="CustomTitleBar"
            Background="{DynamicResource App.WindowBackgroundBrush}"
            MouseLeftButtonDown="CustomTitleBar_OnMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource App.TextPrimaryBrush}"
                    Text="{Binding WindowTitle}" />
                <TextBlock
                    Margin="18,2,0,0"
                    VerticalAlignment="Center"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                    Text="{Binding SelectedDateDisplay}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Margin="0,7,12,0"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Button
                    Width="42"
                    Height="34"
                    Margin="0,0,8,0"
                    Command="{Binding OpenSettingsCommand}"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Style="{StaticResource WindowCaptionButtonStyle}"
                    ToolTip="{markup:Loc Settings.OpenButtonHint}"
                    Content="&#xE713;" />
                <Button
                    Style="{StaticResource WindowCaptionButtonStyle}"
                    Click="MinimizeButton_OnClick"
                    Content="&#xE921;" />
                <Button
                    Style="{StaticResource WindowCaptionButtonStyle}"
                    Click="MaximizeRestoreButton_OnClick"
                    Content="&#xE922;" />
                <Button
                    Style="{StaticResource WindowCloseCaptionButtonStyle}"
                    Click="CloseButton_OnClick"
                    Content="&#xE8BB;" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="24"
                Background="{DynamicResource App.SurfaceSecondaryBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource App.TextSecondaryBrush}"
                        Text="{Binding StatusText}"
                        TextWrapping="Wrap" />

                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <Viewbox
                            Stretch="Uniform">
                            <Calendar
                                Style="{StaticResource CalendarPanelStyle}"
                                SelectedDate="{Binding SelectedDateValue, Mode=TwoWay}">
                                <Calendar.Resources>
                                    <Style TargetType="{x:Type CalendarItem}">
                                        <Setter Property="Background" Value="{DynamicResource App.SurfaceSecondaryBrush}" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type CalendarItem}">
                                                    <Border
                                                        Background="{DynamicResource App.SurfaceSecondaryBrush}"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="0">
                                                        <Grid
                                                            x:Name="PART_Root"
                                                            Background="{DynamicResource App.SurfaceSecondaryBrush}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>

                                                            <Grid
                                                                Margin="0,0,0,10"
                                                                Background="{DynamicResource App.SurfaceSecondaryBrush}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="42" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="42" />
                                                                </Grid.ColumnDefinitions>

                                                                <Button
                                                                    x:Name="PART_PreviousButton"
                                                                    Grid.Column="0"
                                                                    Width="34"
                                                                    Height="30"
                                                                    HorizontalAlignment="Left"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    FocusVisualStyle="{x:Null}"
                                                                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                                                                    Content="‹" />

                                                                <Button
                                                                    x:Name="PART_HeaderButton"
                                                                    Grid.Column="1"
                                                                    Height="30"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    FocusVisualStyle="{x:Null}"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource App.TextPrimaryBrush}" />

                                                                <Button
                                                                    x:Name="PART_NextButton"
                                                                    Grid.Column="2"
                                                                    Width="34"
                                                                    Height="30"
                                                                    HorizontalAlignment="Right"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    FocusVisualStyle="{x:Null}"
                                                                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                                                                    Content="›" />
                                                            </Grid>

                                                            <Grid
                                                                x:Name="PART_MonthView"
                                                                Grid.Row="1"
                                                                Background="{DynamicResource App.SurfaceSecondaryBrush}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                            </Grid>

                                                            <Grid
                                                                x:Name="PART_YearView"
                                                                Grid.Row="1"
                                                                Background="{DynamicResource App.SurfaceSecondaryBrush}"
                                                                Visibility="Hidden">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="{x:Type CalendarButton}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type CalendarButton}">
                                                    <Border
                                                        x:Name="RootBorder"
                                                        Margin="2"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="7"
                                                        Padding="8,6">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                            Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource App.SurfaceHoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.45" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="{x:Type CalendarDayButton}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                                                    <Border
                                                        x:Name="RootBorder"
                                                        Margin="2"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="7,5">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                            Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource App.SurfaceHoverBrush}" />
                                                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource App.BorderStrongBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource App.SurfaceSelectedBrush}" />
                                                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource App.BorderSelectedBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsToday" Value="True">
                                                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource App.AccentPrimaryBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsInactive" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource App.TextMutedBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.45" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Calendar.Resources>
                            </Calendar>
                        </Viewbox>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Command="{Binding PreviousDayCommand}"
                                Content="{markup:Loc MainWindow.PreviousDay}" />

                            <Button
                                Grid.Column="2"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Command="{Binding NextDayCommand}"
                                Content="{markup:Loc MainWindow.NextDay}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Padding="24"
                Background="{DynamicResource App.SurfacePrimaryBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            FontSize="13"
                            Foreground="{DynamicResource App.TextMutedBrush}"
                            Text="{markup:Loc MainWindow.RecordsForDate}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.TextPrimaryBrush}"
                            Text="{Binding SelectedDateDisplay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource App.TextMutedBrush}"
                            Text="{markup:Loc MainWindow.Filter}" />
                        <ComboBox
                            Width="200"
                            Margin="0,6,0,0"
                            ItemsSource="{Binding FilterOptions}"
                            SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <WrapPanel
                    Grid.Row="1"
                    Margin="0,20,0,0"
                    ItemHeight="44"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="130"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Command="{Binding OpenCreateRecordCommand}"
                        Content="{markup:Loc MainWindow.NewRecord}" />
                    <Button
                        Margin="12,0,0,0"
                        MinWidth="130"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Command="{Binding OpenEditRecordCommand}"
                        Content="{markup:Loc MainWindow.EditRecord}" />
                    <Button
                        Margin="12,0,0,0"
                        MinWidth="130"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Click="DeleteRecordButton_OnClick"
                        Content="{markup:Loc MainWindow.DeleteRecord}" />
                    <Button
                        Margin="12,0,0,0"
                        MinWidth="130"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="{markup:Loc MainWindow.Refresh}" />
                </WrapPanel>

                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Border
                        Background="{DynamicResource App.SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{DynamicResource App.TextMutedBrush}"
                                Text="{markup:Loc MainWindow.NoRecords}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Records.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListBox
                                x:Name="RecordsList"
                                AllowDrop="True"
                                Margin="14"
                                ItemsSource="{Binding Records}"
                                PreviewMouseLeftButtonDown="RecordsList_OnPreviewMouseLeftButtonDown"
                                PreviewMouseMove="RecordsList_OnPreviewMouseMove"
                                PreviewMouseDoubleClick="RecordsList_OnPreviewMouseDoubleClick"
                                DragOver="RecordsList_OnDragOver"
                                Drop="RecordsList_OnDrop"
                                DragLeave="RecordsList_OnDragLeave"
                                Background="Transparent"
                                BorderThickness="0"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                SelectedItem="{Binding SelectedRecord, Mode=TwoWay}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,12,12" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Top" />
                                        <Setter Property="VerticalAlignment" Value="Top" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Width">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource AdaptiveCardWidthConverter}">
                                                    <Binding ElementName="RecordsList" Path="ActualWidth" />
                                                    <Binding ElementName="RecordsList" Path="Items.Count" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Records.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            x:Name="CardRoot"
                                            MinHeight="220"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource App.SurfacePrimaryBrush}"
                                            BorderBrush="{DynamicResource App.BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Grid Margin="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Border
                                                        x:Name="TypeBadge"
                                                        HorizontalAlignment="Left"
                                                        Style="{StaticResource NeutralChipBorderStyle}">
                                                        <TextBlock
                                                            Style="{StaticResource ChipTextStyle}"
                                                            Text="{Binding TypeDisplayName}" />
                                                    </Border>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Orientation="Horizontal">
                                                        <Border
                                                            x:Name="CreatedAtBadge"
                                                            Margin="0,0,8,0"
                                                            Style="{StaticResource CreatedAtChipBorderStyle}">
                                                            <TextBlock
                                                                Style="{StaticResource CreatedAtChipTextStyle}"
                                                                Text="{Binding CreatedAtDisplay}" />
                                                        </Border>

                                                        <Border
                                                            x:Name="InfoBadge"
                                                            Margin="0,0,8,0"
                                                            Style="{StaticResource NeutralChipBorderStyle}">
                                                            <TextBlock
                                                                Style="{StaticResource ChipTextStyle}"
                                                                Text="{Binding TimeDisplay}" />
                                                        </Border>

                                                        <Border
                                                            x:Name="EventStatusChip"
                                                            Margin="0,0,8,0"
                                                            Background="{DynamicResource App.StatusInfoBackgroundBrush}"
                                                            BorderBrush="{DynamicResource App.StatusInfoBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Padding="10,6"
                                                            Visibility="Collapsed">
                                                            <TextBlock
                                                                x:Name="EventStatusText"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource App.StatusInfoForegroundBrush}"
                                                                Text="{Binding EventStatusText}" />
                                                        </Border>

                                                        <Button
                                                            x:Name="TaskStatusChip"
                                                            Command="{Binding DataContext.ToggleTaskCompletionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource StatusChipButtonStyle}"
                                                            Visibility="Collapsed">
                                                        </Button>
                                                    </StackPanel>

                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Grid.ColumnSpan="2"
                                                        Margin="0,14,0,0"
                                                        FontSize="18"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis"
