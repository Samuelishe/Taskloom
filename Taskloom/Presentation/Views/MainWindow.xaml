<Window x:Class="Taskloom.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="720"
        MinWidth="960"
        MinHeight="600">
    <Grid Background="#FFF7F4EE">
        <Border
            Margin="24"
            Padding="32"
            Background="White"
            BorderBrush="#FFE0D7C8"
            BorderThickness="1"
            CornerRadius="16">
            <StackPanel>
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="#FF2F2A24"
                    Text="{Binding WindowTitle}" />
                <TextBlock
                    Margin="0,12,0,0"
                    FontSize="16"
                    Foreground="#FF5F574D"
                    Text="{Binding SelectedDateDisplay}" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="14"
                    Foreground="#FF7B7268"
                    Text="{Binding StatusText}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
