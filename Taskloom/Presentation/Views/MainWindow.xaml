<Window x:Class="Taskloom.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Taskloom.Common.Converters"
        xmlns:domain="clr-namespace:Taskloom.Domain"
        xmlns:markup="clr-namespace:Taskloom.Common.Markup"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1460"
        Height="920"
        MinWidth="1280"
        MinHeight="800"
        Background="{DynamicResource App.WindowBackgroundBrush}"
        WindowStyle="None"
        ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="48"
            CornerRadius="0"
            GlassFrameThickness="0"
            NonClientFrameEdges="None"
            ResizeBorderThickness="8"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:AdaptiveCardWidthConverter x:Key="AdaptiveCardWidthConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="CustomTitleBar"
            Background="{DynamicResource App.WindowBackgroundBrush}"
            MouseLeftButtonDown="CustomTitleBar_OnMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource App.TextPrimaryBrush}"
                    Text="{Binding WindowTitle}" />
                <TextBlock
                    Margin="18,2,0,0"
                    VerticalAlignment="Center"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                    Text="{Binding SelectedDateDisplay}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Margin="0,7,12,0"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Button
                    Width="42"
                    Height="34"
                    Margin="0,0,8,0"
                    Command="{Binding OpenSettingsCommand}"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Style="{StaticResource WindowCaptionButtonStyle}"
                    ToolTip="{markup:Loc Settings.OpenButtonHint}"
                    Content="&#xE713;" />
                <Button
                    Style="{StaticResource WindowCaptionButtonStyle}"
                    Click="MinimizeButton_OnClick"
                    Content="&#xE921;" />
                <Button
                    Style="{StaticResource WindowCaptionButtonStyle}"
                    Click="MaximizeRestoreButton_OnClick"
                    Content="&#xE922;" />
                <Button
                    Style="{StaticResource WindowCloseCaptionButtonStyle}"
                    Click="CloseButton_OnClick"
                    Content="&#xE8BB;" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="24"
                Background="{DynamicResource App.SurfaceSecondaryBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                <Border
                    Margin="0"
                    Padding="18"
                    Background="{DynamicResource App.SurfaceTertiaryBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.TextPrimaryBrush}"
                            Text="{Binding SelectedDateDisplay}" />

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource App.TextSecondaryBrush}"
                                Text="{Binding StatusText}"
                                TextWrapping="Wrap" />

                            <Button
                                Grid.Column="2"
                                MinWidth="120"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Command="{Binding PreviousDayCommand}"
                                Content="{markup:Loc MainWindow.PreviousDay}" />

                            <Button
                                Grid.Column="4"
                                MinWidth="120"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Command="{Binding NextDayCommand}"
                                Content="{markup:Loc MainWindow.NextDay}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    Padding="8"
                    Background="{DynamicResource App.SurfaceTertiaryBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                    <Viewbox Stretch="Uniform">
                        <Calendar
                            Background="Transparent"
                            BorderThickness="0"
                            SelectedDate="{Binding SelectedDateValue, Mode=TwoWay}" />
                    </Viewbox>
                </Border>
            </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Padding="24"
                Background="{DynamicResource App.SurfacePrimaryBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            FontSize="13"
                            Foreground="{DynamicResource App.TextMutedBrush}"
                            Text="{markup:Loc MainWindow.RecordsForDate}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.TextPrimaryBrush}"
                            Text="{Binding SelectedDateDisplay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource App.TextMutedBrush}"
                            Text="{markup:Loc MainWindow.Filter}" />
                        <ComboBox
                            Width="200"
                            Margin="0,6,0,0"
                            ItemsSource="{Binding FilterOptions}"
                            SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <WrapPanel
                    Grid.Row="1"
                    Margin="0,20,0,0"
                    ItemHeight="42"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="130"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Command="{Binding OpenCreateRecordCommand}"
                        Content="{markup:Loc MainWindow.NewRecord}" />
                    <Button
                        Margin="12,0,0,0"
                        MinWidth="130"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Command="{Binding OpenEditRecordCommand}"
                        Content="{markup:Loc MainWindow.EditRecord}" />
                    <Button
                        Margin="12,0,0,0"
                        MinWidth="130"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Click="DeleteRecordButton_OnClick"
                        Content="{markup:Loc MainWindow.DeleteRecord}" />
                    <Button
                        Margin="12,0,0,0"
                        MinWidth="130"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="{markup:Loc MainWindow.Refresh}" />
                </WrapPanel>

                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Border
                        Background="{DynamicResource App.SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{DynamicResource App.TextMutedBrush}"
                                Text="{markup:Loc MainWindow.NoRecords}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Records.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListBox
                                x:Name="RecordsList"
                                Margin="14"
                                ItemsSource="{Binding Records}"
                                MouseDoubleClick="RecordsList_OnMouseDoubleClick"
                                Background="Transparent"
                                BorderThickness="0"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                SelectedItem="{Binding SelectedRecord, Mode=TwoWay}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,12,12" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Width">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource AdaptiveCardWidthConverter}">
                                                    <Binding ElementName="RecordsList" Path="ActualWidth" />
                                                    <Binding ElementName="RecordsList" Path="Items.Count" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Records.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            x:Name="CardRoot"
                                            MinHeight="176"
                                            Background="{DynamicResource App.SurfacePrimaryBrush}"
                                            BorderBrush="{DynamicResource App.BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    x:Name="SelectionStripe"
                                                    Margin="0"
                                                    Background="Transparent"
                                                    CornerRadius="14,0,0,14" />

                                                <Grid Grid.Column="1" Margin="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <Border
                                                        x:Name="TypeBadge"
                                                        HorizontalAlignment="Left"
                                                        Style="{StaticResource NeutralChipBorderStyle}">
                                                        <TextBlock
                                                            Style="{StaticResource ChipTextStyle}"
                                                            Text="{Binding TypeDisplayName}" />
                                                    </Border>

                                                    <Grid Grid.Column="1">
                                                        <Border
                                                            x:Name="InfoBadge"
                                                            Style="{StaticResource NeutralChipBorderStyle}">
                                                            <TextBlock
                                                                Style="{StaticResource ChipTextStyle}"
                                                                Text="{Binding TimeDisplay}" />
                                                        </Border>

                                                        <Button
                                                            x:Name="TaskStatusChip"
                                                            Command="{Binding DataContext.ToggleTaskCompletionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource StatusChipButtonStyle}"
                                                            Visibility="Collapsed">
                                                        </Button>
                                                    </Grid>

                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Grid.ColumnSpan="2"
                                                        Margin="0,14,0,0"
                                                        FontSize="18"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="Wrap" />

                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Margin="0,10,0,0"
                                                        Foreground="{DynamicResource App.TextSecondaryBrush}"
                                                        MaxHeight="84"
                                                        Text="{Binding Details}"
                                                        TextTrimming="WordEllipsis"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                <Setter TargetName="CardRoot" Property="Background" Value="{DynamicResource App.SurfaceHoverBrush}" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                <Setter TargetName="CardRoot" Property="Background" Value="{DynamicResource App.SurfaceSelectedBrush}" />
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource App.BorderSelectedBrush}" />
                                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="2" />
                                                <Setter TargetName="SelectionStripe" Property="Background" Value="{DynamicResource App.SelectionStripeBrush}" />
                                                <Setter TargetName="TypeBadge" Property="Background" Value="{DynamicResource App.SurfacePrimaryBrush}" />
                                                <Setter TargetName="TypeBadge" Property="BorderBrush" Value="{DynamicResource App.BorderStrongBrush}" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsTask}" Value="True">
                                                <Setter TargetName="InfoBadge" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="TaskStatusChip" Property="Visibility" Value="Visible" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                <Setter TargetName="TaskStatusChip" Property="Background" Value="{DynamicResource App.StatusSuccessBackgroundBrush}" />
                                                <Setter TargetName="TaskStatusChip" Property="BorderBrush" Value="{DynamicResource App.StatusSuccessBorderBrush}" />
                                                <Setter TargetName="TaskStatusChip" Property="Foreground" Value="{DynamicResource App.StatusSuccessForegroundBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
