<Window x:Class="Taskloom.Presentation.Views.RecordEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:markup="clr-namespace:Taskloom.Common.Markup"
        mc:Ignorable="d"
        Title="{Binding EditorTitle}"
        Width="560"
        Height="720"
        MinWidth="520"
        MinHeight="640"
        Background="{DynamicResource App.WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="{DynamicResource App.TextPrimaryBrush}"
                Text="{Binding EditorTitle}" />

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock FontSize="12" Foreground="{DynamicResource App.TextMutedBrush}" Text="{markup:Loc Editor.RecordType}" />
                <ComboBox
                    Margin="0,6,0,0"
                    ItemsSource="{Binding RecordTypeOptions}"
                    SelectedValue="{Binding Type, Mode=TwoWay}"
                    SelectedValuePath="RecordType">
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock FontSize="12" Foreground="{DynamicResource App.TextMutedBrush}" Text="{markup:Loc Editor.Date}" />
                <DatePicker
                    Margin="0,6,0,0"
                    SelectedDate="{Binding DateValue, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <TextBlock FontSize="12" Foreground="{DynamicResource App.TextMutedBrush}" Text="{markup:Loc Editor.Title}" />
                <TextBox
                    Margin="0,6,0,0"
                    Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,16,0,0">
                <TextBlock FontSize="12" Foreground="{DynamicResource App.TextMutedBrush}" Text="{markup:Loc Editor.Details}" />
                <TextBox
                    Margin="0,6,0,0"
                    AcceptsReturn="True"
                    Height="120"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    Text="{Binding Details, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Border Grid.Row="5" Margin="0,16,0,0" Background="{DynamicResource App.SurfaceMutedBrush}" CornerRadius="12" Padding="14">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="{DynamicResource App.TextMutedBrush}" Text="{markup:Loc Editor.TaskOptions}" />
                    <CheckBox
                        Margin="0,8,0,0"
                        Content="{markup:Loc Editor.Completed}"
                        IsChecked="{Binding IsCompleted, Mode=TwoWay}">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTask}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Grid.Row="6" Margin="0,16,0,0" Background="{DynamicResource App.SurfaceMutedBrush}" CornerRadius="12" Padding="14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEvent}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="{DynamicResource App.TextMutedBrush}" Text="{markup:Loc Editor.EventOptions}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="12" Foreground="{DynamicResource App.TextMutedBrush}" Text="{markup:Loc Editor.StartTime}" />
                            <TextBox
                                Margin="0,6,0,0"
                                Text="{Binding StartTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock FontSize="12" Foreground="{DynamicResource App.TextMutedBrush}" Text="{markup:Loc Editor.EndTime}" />
                            <TextBox
                                Margin="0,6,0,0"
                                Text="{Binding EndTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock FontSize="12" Foreground="{DynamicResource App.TextMutedBrush}" Text="{markup:Loc Editor.Location}" />
                        <TextBox
                            Margin="0,6,0,0"
                            Text="{Binding Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock
                Grid.Row="7"
                Margin="0,16,0,0"
                Foreground="{DynamicResource App.ErrorBrush}"
                Text="{Binding ValidationMessage}"
                TextWrapping="Wrap" />

            <TextBlock
                Grid.Row="8"
                Margin="0,8,0,0"
                Foreground="{DynamicResource App.TextMutedBrush}"
                Text="{markup:Loc Editor.TimeFormatHint}"
                TextWrapping="Wrap" />

            <StackPanel
                Grid.Row="10"
                Margin="0,24,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="120"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    Command="{Binding CancelCommand}"
                    Content="{markup:Loc Editor.Cancel}" />
                <Button
                    Width="120"
                    Margin="12,0,0,0"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    Command="{Binding SaveCommand}"
                    Content="{markup:Loc Editor.Save}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
