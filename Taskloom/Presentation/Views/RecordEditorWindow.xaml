<Window x:Class="Taskloom.Presentation.Views.RecordEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Taskloom.Common.Converters"
        xmlns:markup="clr-namespace:Taskloom.Common.Markup"
        mc:Ignorable="d"
        Title="{Binding EditorTitle}"
        Width="700"
        Height="860"
        MinWidth="600"
        MinHeight="720"
        Background="{DynamicResource App.BorderStrongBrush}"
        Icon="/Assets/Icons/Taskloom.ico"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="48"
            CornerRadius="0"
            GlassFrameThickness="0"
            NonClientFrameEdges="None"
            ResizeBorderThickness="8"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border
        Padding="1"
        Background="{DynamicResource App.BorderStrongBrush}">
        <Grid Background="{DynamicResource App.SurfacePrimaryBrush}">
            <Grid.Resources>
                <converters:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter" />
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Background="{DynamicResource App.SurfaceSecondaryBrush}"
                MouseLeftButtonDown="CustomTitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Margin="24,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource App.TextPrimaryBrush}"
                    Text="{Binding EditorTitle}" />

                <Button
                    Grid.Column="1"
                    Margin="0,7,12,0"
                    Style="{StaticResource WindowCloseCaptionButtonStyle}"
                    Click="CloseButton_OnClick"
                    Content="&#xE8BB;"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="26">
            <Grid.Resources>
                <Style x:Key="EditorFieldLabelStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Foreground" Value="{DynamicResource App.TextMutedBrush}" />
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource EditorFieldLabelStyle}" Text="{markup:Loc Editor.RecordType}" />
                <ComboBox
                    Margin="0,6,0,0"
                    ItemsSource="{Binding RecordTypeOptions}"
                    SelectedValue="{Binding Type, Mode=TwoWay}"
                    SelectedValuePath="RecordType">
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Style="{StaticResource EditorFieldLabelStyle}" Text="{markup:Loc Editor.Date}" />
                <DatePicker
                    Width="300"
                    HorizontalAlignment="Left"
                    Margin="0,6,0,0"
                    SelectedDate="{Binding DateValue, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Style="{StaticResource EditorFieldLabelStyle}" Text="{markup:Loc Editor.Title}" />
                <TextBox
                    Margin="0,6,0,0"
                    Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <TextBlock Style="{StaticResource EditorFieldLabelStyle}" Text="{markup:Loc Editor.Details}" />
                <TextBox
                    Margin="0,6,0,0"
                    AcceptsReturn="True"
                    Height="136"
                    Padding="12,9"
                    VerticalContentAlignment="Top"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    Text="{Binding Details, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Border Grid.Row="4" Margin="0,18,0,0" Background="{DynamicResource App.SurfaceMutedBrush}" CornerRadius="12" Padding="15">
                <StackPanel>
                    <TextBlock Style="{StaticResource EditorFieldLabelStyle}" Text="{markup:Loc Editor.Images}" />
                    <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                        <Button
                            MinWidth="156"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Click="BrowseImagesButton_OnClick"
                            Content="{markup:Loc Editor.AttachImages}" />
                    </WrapPanel>

                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="{DynamicResource App.TextMutedBrush}"
                        Text="{markup:Loc Editor.NoImages}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasImages}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Images}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasImages}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="168"
                                    Margin="0,0,12,12"
                                    Background="{DynamicResource App.SurfacePrimaryBrush}"
                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8">
                                    <StackPanel>
                                        <Border
                                            BorderBrush="{DynamicResource App.BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Height="120"
                                            Padding="6">
                                            <Image
                                                Stretch="Uniform"
                                                Source="{Binding PreviewPath, Converter={StaticResource ImagePathToBitmapConverter}, ConverterParameter=240}" />
                                        </Border>

                                        <TextBlock
                                            Margin="0,8,0,0"
                                            Foreground="{DynamicResource App.TextSecondaryBrush}"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />

                                        <WrapPanel Margin="0,8,0,0">
                                            <Button
                                                Width="34"
                                                Height="34"
                                                Click="MoveImageLeftButton_OnClick"
                                                Content="←"
                                                Tag="{Binding}"
                                                ToolTip="{markup:Loc Editor.MoveImageLeft}"
                                                Style="{StaticResource CompactActionButtonStyle}" />
                                            <Button
                                                Width="34"
                                                Height="34"
                                                Margin="6,0,0,0"
                                                Click="MoveImageRightButton_OnClick"
                                                Content="→"
                                                Tag="{Binding}"
                                                ToolTip="{markup:Loc Editor.MoveImageRight}"
                                                Style="{StaticResource CompactActionButtonStyle}" />
                                            <Button
                                                Width="34"
                                                Height="34"
                                                Margin="6,0,0,0"
                                                Click="RemoveImageButton_OnClick"
                                                Content="✕"
                                                Tag="{Binding}"
                                                ToolTip="{markup:Loc Editor.RemoveImage}"
                                                Style="{StaticResource CompactActionButtonStyle}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Margin="0,18,0,0" Background="{DynamicResource App.SurfaceMutedBrush}" CornerRadius="12" Padding="15">
                <StackPanel>
                    <TextBlock Style="{StaticResource EditorFieldLabelStyle}" Text="{markup:Loc Editor.Audio}" />
                    <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                        <Button
                            MinWidth="156"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Click="BrowseAudiosButton_OnClick"
                            Content="{markup:Loc Editor.AttachAudio}" />
                    </WrapPanel>

                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="{DynamicResource App.TextMutedBrush}"
                        Text="{markup:Loc Editor.NoAudio}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAudios}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Audios}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAudios}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,12"
                                    Background="{DynamicResource App.SurfacePrimaryBrush}"
                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="68"
                                            Height="68"
                                            Background="{DynamicResource App.SurfaceSecondaryBrush}"
                                            BorderBrush="{DynamicResource App.BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe UI Symbol"
                                                FontSize="18"
                                                Foreground="{DynamicResource App.TextSecondaryBrush}"
                                                Text="♪" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Foreground="{DynamicResource App.TextSecondaryBrush}"
                                                Text="{Binding OriginalFileName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Foreground="{DynamicResource App.TextMutedBrush}"
                                                Text="{Binding DurationSeconds, StringFormat={}{0:F0} s}" />
                                        </StackPanel>

                                        <WrapPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Button
                                                Width="34"
                                                Height="34"
                                                Click="MoveAudioLeftButton_OnClick"
                                                Content="←"
                                                Tag="{Binding}"
                                                ToolTip="{markup:Loc Editor.MoveAudioLeft}"
                                                Style="{StaticResource CompactActionButtonStyle}" />
                                            <Button
                                                Width="34"
                                                Height="34"
                                                Margin="6,0,0,0"
                                                Click="MoveAudioRightButton_OnClick"
                                                Content="→"
                                                Tag="{Binding}"
                                                ToolTip="{markup:Loc Editor.MoveAudioRight}"
                                                Style="{StaticResource CompactActionButtonStyle}" />
                                            <Button
                                                Width="34"
                                                Height="34"
                                                Margin="6,0,0,0"
                                                Click="RemoveAudioButton_OnClick"
                                                Content="✕"
                                                Tag="{Binding}"
                                                ToolTip="{markup:Loc Editor.RemoveAudio}"
                                                Style="{StaticResource CompactActionButtonStyle}" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="6" Margin="0,18,0,0" Background="{DynamicResource App.SurfaceMutedBrush}" CornerRadius="12" Padding="15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTask}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource EditorFieldLabelStyle}" Text="{markup:Loc Editor.TaskOptions}" />
                    <CheckBox
                        Margin="0,8,0,0"
                        Content="{markup:Loc Editor.Completed}"
                        Foreground="{DynamicResource App.TextPrimaryBrush}"
                        IsChecked="{Binding IsCompleted, Mode=TwoWay}" />
                    <CheckBox
                        Margin="0,8,0,0"
                        Content="{markup:Loc Editor.TaskReminderEnabled}"
                        Foreground="{DynamicResource App.TextPrimaryBrush}"
                        IsChecked="{Binding HasTaskReminder, Mode=TwoWay}" />
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTaskReminder}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource EditorFieldLabelStyle}" Text="{markup:Loc Editor.TaskReminderTime}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                Grid.Column="0"
                                ItemsSource="{Binding HourOptions}"
                                DisplayMemberPath="Title"
                                SelectedValuePath="Value"
                                SelectedValue="{Binding SelectedTaskReminderHour, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource App.TextSecondaryBrush}"
                                Text=":" />
                            <ComboBox
                                Grid.Column="2"
                                ItemsSource="{Binding MinuteSecondOptions}"
                                DisplayMemberPath="Title"
                                SelectedValuePath="Value"
                                SelectedValue="{Binding SelectedTaskReminderMinute, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="7" Margin="0,18,0,0" Background="{DynamicResource App.SurfaceMutedBrush}" CornerRadius="12" Padding="15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEvent}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource EditorFieldLabelStyle}" Text="{markup:Loc Editor.EventOptions}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource EditorFieldLabelStyle}" Text="{markup:Loc Editor.EventStatus}" />
                            <ComboBox
                                Margin="0,6,0,0"
                                ItemsSource="{Binding EventStatusOptions}"
                                SelectedValue="{Binding EventStatus, Mode=TwoWay}"
                                SelectedValuePath="Status" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource EditorFieldLabelStyle}" Text="{markup:Loc Editor.Reminder}" />
                            <ComboBox
                                Margin="0,6,0,0"
                                ItemsSource="{Binding ReminderOptions}"
                                SelectedValue="{Binding ReminderMinutesBefore, Mode=TwoWay}"
                                SelectedValuePath="MinutesBefore" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource EditorFieldLabelStyle}" Text="{markup:Loc Editor.StartTime}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ComboBox
                                    Grid.Column="0"
                                    ItemsSource="{Binding HourOptions}"
                                    DisplayMemberPath="Title"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding SelectedStartHour, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                                    Text=":" />
                                <ComboBox
                                    Grid.Column="2"
                                    ItemsSource="{Binding MinuteSecondOptions}"
                                    DisplayMemberPath="Title"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding SelectedStartMinute, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                                    Text=":" />
                                <ComboBox
                                    Grid.Column="4"
                                    ItemsSource="{Binding MinuteSecondOptions}"
                                    DisplayMemberPath="Title"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding SelectedStartSecond, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource EditorFieldLabelStyle}" Text="{markup:Loc Editor.EndTime}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ComboBox
                                    Grid.Column="0"
                                    ItemsSource="{Binding HourOptions}"
                                    DisplayMemberPath="Title"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding SelectedEndHour, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                                    Text=":" />
                                <ComboBox
                                    Grid.Column="2"
                                    ItemsSource="{Binding MinuteSecondOptions}"
                                    DisplayMemberPath="Title"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding SelectedEndMinute, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                                    Text=":" />
                                <ComboBox
                                    Grid.Column="4"
                                    ItemsSource="{Binding MinuteSecondOptions}"
                                    DisplayMemberPath="Title"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding SelectedEndSecond, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource EditorFieldLabelStyle}" Text="{markup:Loc Editor.Location}" />
                        <TextBox
                            Margin="0,6,0,0"
                            Text="{Binding Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Border>

                </Grid>
            </ScrollViewer>

            <Border
                Grid.Row="2"
                Padding="24,16,24,24"
                Background="{DynamicResource App.SurfacePrimaryBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Foreground="{DynamicResource App.ErrorBrush}"
                        Text="{Binding ValidationMessage}"
                        TextWrapping="Wrap" />

                    <StackPanel
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="126"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Command="{Binding CancelCommand}"
                            Content="{markup:Loc Editor.Cancel}" />
                        <Button
                            Width="126"
                            Margin="12,0,0,0"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Command="{Binding SaveCommand}"
                            Content="{markup:Loc Editor.Save}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
